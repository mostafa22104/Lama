{
  "font": {
    "family": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', Tahoma, sans-serif",
    "weights": [400, 500, 600, 700],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap",
    "scale": {
      "display": { "size": 38, "weight": 700, "lineHeight": 1.35 },
      "screenTitle": { "size": 22, "weight": 700, "lineHeight": 1.3 },
      "section": { "size": 18, "weight": 700 },
      "body": { "size": 16, "weight": 400, "lineHeight": 1.7 },
      "caption": { "size": 13, "weight": 500 }
    }
  },
  "color": {
    "bg": "#F6F4EF",
    "surface": "#FFFFFF",
    "ink": "#1C2B2A",
    "muted": "#5E6A67",
    "line": "#E4DFD5",
    "inputBorder": "#D6D0C4",
    "primary": "#0F5E56",
    "primaryDark": "#0A4540",
    "primarySoft": "#E2EEEB",
    "gold": "#B7791F",
    "goldSoft": "#F6ECD8",
    "logoAccent": "#F3D9A4",
    "whatsapp": "#177A45",
    "whatsappSoft": "#DCF3E4",
    "danger": "#A8231B",
    "dangerSoft": "#FBE4E1",
    "disabledBg": "#D9D5CC",
    "chatBg": "#EFE7DC"
  },
  "status": {
    "paid":     { "label": "مدفوع",              "fg": "#1B6B43", "bg": "#E2F1E8" },
    "dueSoon":  { "label": "مستحق قريب",         "fg": "#8A5300", "bg": "#FBEFD6" },
    "overdue":  { "label": "متأخر",              "fg": "#A8231B", "bg": "#FBE4E1" },
    "awaiting": { "label": "في انتظار التأكيد",  "fg": "#2A578F", "bg": "#E4ECF7" }
  },
  "radius": { "chip": 999, "button": 14, "input": 14, "card": 18, "cardLarge": 22, "iconTile": 14 },
  "size": { "buttonPrimary": 56, "buttonSecondary": 52, "minTapTarget": 44, "input": 56, "bottomNav": 72, "avatar": 40 },
  "spacing": { "screenPaddingX": 16, "stackGap": 14, "cardPadding": 16 },
  "breakpoints": { "mobile": 375, "desktop": 1280 }
}
